# /etc/systemd/system/borsabot.service
# Kurulum:  sudo cp deploy/borsabot.service /etc/systemd/system/
#           sudo systemctl daemon-reload && sudo systemctl enable --now borsabot

[Unit]
Description=BorsaBot Finans (Streamlit)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=borsabot
Group=borsabot
WorkingDirectory=/opt/borsabot

# Streamlit ve yfinance ev dizinine yazar; sistem kullanıcısının evi uygulama klasörü
Environment="HOME=/opt/borsabot"
Environment="PYTHONUNBUFFERED=1"

# Sadece 127.0.0.1'e bağlanır: 8501 portu dışarıdan erişilemez, önüne nginx girer
ExecStart=/opt/borsabot/.venv/bin/streamlit run app.py \
    --server.address 127.0.0.1 \
    --server.port 8501 \
    --server.headless true \
    --server.enableCORS false \
    --server.enableXsrfProtection true \
    --browser.gatherUsageStats false

Restart=always
RestartSec=5

# Sıkılaştırma
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/borsabot

[Install]
WantedBy=multi-user.target
